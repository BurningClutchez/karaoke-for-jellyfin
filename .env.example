# Every setting is described in HOWTO.md, section 10.

# Jellyfin Configuration
JELLYFIN_SERVER_URL=http(s)://your.server.url
JELLYFIN_API_KEY=apikey
JELLYFIN_USERNAME=YourAdminUsername

# Android TV APK Build Configuration
# KARAOKE_SERVER_URL: The URL where your Karaoke server will be accessible from Android TV devices
# This should be the IP address and port where your karaoke server runs on your local network
# The Android TV app will connect to this URL to access the karaoke interface
# Examples:
#   - Local network: http://192.168.1.100:3967 (replace with your server's IP)
#   - Docker host: http://192.168.1.50:3967 (if running in Docker)
#   - Different port: http://192.168.1.100:8080 (if using a different port)
# Note: Use your server's actual IP address, not localhost, so Android TV can reach it
KARAOKE_SERVER_URL=http://192.168.1.100:3967

# TV Display Timing Configuration (in milliseconds)
RATING_ANIMATION_DURATION=15000
NEXT_SONG_DURATION=15000
CONTROLS_AUTO_HIDE_DELAY=10000
AUTOPLAY_DELAY=500
QUEUE_AUTOPLAY_DELAY=1000
TIME_UPDATE_INTERVAL=2000

# CD+G karaoke graphics (see docs/CDG.md)
# auto (default) | canvas | video | off
#CDG_MODE=auto
# Option A: the music library mounted into this app, and the same folder as Jellyfin sees it
#CDG_LOCAL_ROOT=/music
#CDG_JELLYFIN_ROOT=/media/music
# Queued songs are rendered to plugin video ahead of time (default: on unless CDG_MODE=off)
#CDG_PRERENDER=false
# Songs phones can pick: karaoke (lyrics or CD+G graphics, default), lyrics, or all
#SONG_FILTER=karaoke

# Logging: debug | info (default) | warn | error; json for one JSON object per line
#LOG_LEVEL=info
#LOG_FORMAT=text
# List artists from only this music library (default: the only one, or all if several).
# To hide regular music everywhere, use a Jellyfin user that can only see karaoke (HOWTO.md 3.2)
#JELLYFIN_MUSIC_LIBRARY=Music
# Allow /api/debug/* in production (they have no login)
#ENABLE_DEBUG_ROUTES=false
# Behind a reverse proxy: take the client's address from X-Forwarded-For (for rate limits)
#TRUST_PROXY=false
# A playing song with no progress from the TV for this long counts as stuck (0 = don't check)
#PLAYBACK_STALL_SECONDS=60
# What to do then: notify (log and tell the phones) or skip (also skip the song)
#PLAYBACK_STALL_ACTION=notify

# Karaoke Party live channel for Jellyfin (M3U tuner: http://<app address>/api/live/channel.m3u)
#LIVE_CHANNEL=true
# Seconds the "Up next" card shows between songs
#LIVE_NEXT_UP_SECONDS=8
# The address phones join on, for the channel's QR code (default: the address Jellyfin used)
#PUBLIC_URL=http://192.168.1.60:3000
# ffmpeg to use (included in the Docker image)
#FFMPEG_PATH=ffmpeg
